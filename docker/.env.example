# KidsPlay Server — environment variable reference
# Copy to docker/.env and adjust for your deployment.
# docker compose automatically loads docker/.env when present.

# ---------------------------------------------------------------------------
# Storage paths (inside the container — match your volume mounts)
# ---------------------------------------------------------------------------

# Absolute path to the SQLite database file inside the container.
# Default (local dev): ~/.local/share/kidsplay/db.sqlite
KIDSPLAY_DB_PATH=/data/db/kidsplay.db

# Root directory for the content-addressed media store inside the container.
# Default (local dev): ~/.local/share/kidsplay/media
KIDSPLAY_MEDIA_STORE=/data/media-store

# ---------------------------------------------------------------------------
# YouTube authentication (optional but recommended)
# ---------------------------------------------------------------------------

# Path to a Netscape-format cookies.txt file inside the container.
# Export from a logged-in browser with the "Get cookies.txt LOCALLY" extension
# (Chrome) or "cookies.txt" (Firefox), then mount the file read-only and set
# this variable.  When unset, yt-dlp runs unauthenticated.
# KIDSPLAY_YT_COOKIES=/data/yt-cookies.txt

# ---------------------------------------------------------------------------
# Admin authentication
# ---------------------------------------------------------------------------

# Pre-seed the admin password (only used while none is set; never overwrites).
# When unset, the web UI shows a first-run setup page instead.
# KIDSPLAY_ADMIN_PASSWORD=change-me

# Reverse proxy in front of the server (Caddy, nginx, Traefik): comma-separated
# addresses/networks of the proxy, as the container sees it. Only these peers
# are believed when they send X-Forwarded-For / X-Forwarded-Proto. Needed for
# per-client login and pairing limits (otherwise everyone is "the proxy").
# Wildcards are refused. See docs/DEVELOPMENT.md#behind-a-reverse-proxy.
# KIDSPLAY_TRUSTED_PROXIES=172.16.0.0/12

# The session cookie is marked Secure automatically when the request arrived
# over HTTPS (directly, or via a trusted proxy sending X-Forwarded-Proto).
# Set 1 to always mark it, or 0 to never.
# KIDSPLAY_COOKIE_SECURE=1

# Key file that signs session cookies. Generated with mode 0600 on first run.
# Default: session_secret.key next to KIDSPLAY_DB_PATH (so it lives in the db
# volume and survives container rebuilds).
# KIDSPLAY_SECRET_KEY_FILE=/data/db/session_secret.key

# "disabled" turns admin authentication OFF. Only for installs behind a reverse
# proxy that already authenticates; the server logs a warning at startup.
# Device sync always uses per-device API keys.
# KIDSPLAY_AUTH=disabled

# Loudness normalization at ingest (EBU R128; see docs/LOUDNESS.md). Targets in
# LUFS, ceiling in dBTP. The targets can also be changed on the web Settings
# page; setting one here locks it there (the environment wins). After changing
# a target, run `kidsplay media normalize --all` (the page offers to).
# "disabled" skips normalization at ingest.
# KIDSPLAY_LOUDNESS_TARGET_LUFS=-16
# KIDSPLAY_LOUDNESS_TRUE_PEAK_DBTP=-1.5
# KIDSPLAY_LOUDNESS_TARGET_LUFS_MUSIC=-16
# KIDSPLAY_LOUDNESS_TARGET_LUFS_AUDIOBOOK=-14
# KIDSPLAY_LOUDNORM=disabled

# ---------------------------------------------------------------------------
# Host-side settings read by docker-compose.yml
# ---------------------------------------------------------------------------

# Host port the web UI / API is published on.
# KIDSPLAY_PORT=8000

# Host directory holding db/ and media-store/ (default: docker/data).
# KIDSPLAY_DATA_DIR=./data

# Host directory mounted read-only at /mnt/source for web-UI imports.
# KIDSPLAY_SOURCE_DIR=./data/source

# Host directory mounted at /data/backups for `kidsplay-server backup`
# (default: docker/data/backups). Put it on a different disk from
# KIDSPLAY_DATA_DIR. Backups contain device API keys; see docs/BACKUP.md.
# KIDSPLAY_BACKUP_DIR=./data/backups

# Handhelds find the server on the network with mDNS (_kidsplay._tcp) while
# pairing. The compose file turns advertising off (bridge networking would
# announce the container's private address). Under `network_mode: host`
# remove KIDSPLAY_MDNS=0 from docker-compose.yml, and set the port devices use:
# KIDSPLAY_MDNS_PORT=8000
